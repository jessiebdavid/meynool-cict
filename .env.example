# Local configuration template. Never put real secrets in this file.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Replace with your local PostgreSQL connection details.
POSTGRES_PASSWORD=local_dev_change_me
DATABASE_URL=postgresql+psycopg://postgres:local_dev_change_me@127.0.0.1:5432/meynool

# Ollama local endpoint and chosen installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=CHANGE_ME_TO_INSTALLED_MODEL

# Authentication/session secret: generate a unique local secret.
# Never commit the real value.
SESSION_SECRET=CHANGE_ME

# Scientific provider configuration; use only if required by provider.
NCBI_API_KEY=
